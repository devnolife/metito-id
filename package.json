{
  "name": "metito-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website resmi PT Multi Enviro Tirta Teknologi (METITO) — Integrated Solutions for Water, Industry and Mining",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "npm run setup-dirs",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:quotations": "tsx prisma/seed-quotations.ts",
    "db:seed:crm": "tsx prisma/seed-crm.ts",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "test-auth": "npx tsx scripts/test-auth.ts",
    "setup-admin": "npx tsx scripts/setup-admin.ts",
    "setup-sales": "npx tsx scripts/setup-sales-team.ts",
    "setup-magang": "npx tsx scripts/setup-magang.ts",
    "reset-password": "npx tsx scripts/reset-password.ts",
    "test-api": "npx tsx scripts/test-all-apis.ts",
    "test-api-quick": "npx tsx scripts/quick-api-test.ts",
    "test-db": "npx tsx scripts/test-database.ts",
    "test-fs": "npx tsx scripts/test-file-system.ts",
    "test-all": "npx tsx scripts/test-all.ts",
    "setup-dirs": "node scripts/setup-upload-dirs.js",
    "brand:assets": "node scripts/generate-brand-assets.js"
  },
